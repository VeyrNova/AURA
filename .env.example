# ============================================
# AURA v0.7.2.1 - Configuration de référence (copier en .env)
# ============================================
APP_NAME=AURA

# IA locale optionnelle (désactivée par défaut en Runtime v2)
LOCAL_LLM_ENABLED=false
LOCAL_LLM_PROVIDER=ollama
LOCAL_LLM_MODEL=llama3.1
LLM_TEXT_MODEL=llama3.1
LLM_VOICE_MODEL=llama3.2:3b
DUAL_BRAIN_ENABLED=false
DUAL_BRAIN_FALLBACK_TO_TEXT=true
DUAL_BRAIN_AUTO_COHABITATION=true
DUAL_BRAIN_VOICE_KEEP_ALIVE=5m
DUAL_BRAIN_MAX_VRAM_PCT=86
DUAL_BRAIN_MIN_FREE_VRAM_MB=700
DUAL_BRAIN_XTTS_ESTIMATE_MB=2800
DUAL_BRAIN_XTTS_IDLE_SECONDS=300
DUAL_BRAIN_PROBE_MAX_VRAM_PCT=88
DUAL_BRAIN_VOICE_RAM_ESTIMATE_GB=4.0
DUAL_BRAIN_LLM_PRELOAD_MAX_RAM_PCT=93
DUAL_BRAIN_LLM_PRELOAD_MIN_AVAILABLE_RAM_GB=1.15
VOICE_RESIDENCY_PRIORITY=true
VOICE_RESIDENCY_RELEASE_LLM_RAM_PCT=94
VOICE_BRAIN_POST_START_PREWARM=true
VOICE_BRAIN_PREWARM_DELAY_MS=1800
VOICE_BRAIN_PREWARM_MAX_RAM_PCT=93
VOICE_BRAIN_PREWARM_MIN_AVAILABLE_RAM_GB=1.15
OLLAMA_HOST=http://localhost:11434
ALLOW_REMOTE_LLM=false
LLM_STREAM=true
LLM_PRELOAD=true
LLM_KEEP_ALIVE=30m
# Resource Guardian remplace ce keep-alive par 2m quand il est actif.
RESOURCE_LLM_KEEP_ALIVE=2m
RESOURCE_LLM_KEEP_ALIVE_TEXT=2m
RESOURCE_LLM_KEEP_ALIVE_VOICE=0
LLM_VOICE_NUM_CTX=2048
LLM_VOICE_NUM_PREDICT=104
LLM_VOICE_TEMPERATURE=0.42
LLM_VOICE_TOP_P=0.82
LLM_VOICE_COMPLETION_GUARD=true
LLM_VOICE_COMPLETION_NUM_PREDICT=48
LLM_VOICE_COMPLETION_TRIGGER_MARGIN=4
LLM_VOICE_QUALITY_GATE=true
LLM_VOICE_QUALITY_NUM_PREDICT=80
LLM_VOICE_QUALITY_MAX_SENTENCES=2
LLM_VOICE_MAX_SENTENCES=3
LLM_VOICE_MAX_CHARS=320
LLM_VOICE_DETAIL_MAX_SENTENCES=5
LLM_VOICE_DETAIL_MAX_CHARS=560
LLM_VOICE_FIRST_SENTENCE_TARGET=85
LLM_VOICE_KNOWLEDGE_GATE=true
LLM_VOICE_KNOWLEDGE_NUM_PREDICT=72
LLM_VOICE_KNOWLEDGE_MAX_SENTENCES=1
LLM_VOICE_KNOWLEDGE_SELF_VERIFY=false
KNOWLEDGE_REFERENCE_ENABLED=true
KNOWLEDGE_REFERENCE_WEB_ENABLED=true
KNOWLEDGE_REFERENCE_MAX_SENTENCES=3
KNOWLEDGE_REFERENCE_MAX_CHARS=420
LLM_VOICE_MAX_HISTORY_MESSAGES=4
LLM_VOICE_MEMORY_LIMIT=2
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=220
LLM_TEMPERATURE=0.62
LLM_TOP_P=0.90
LLM_MAX_HISTORY_MESSAGES=12
LLM_CONNECT_TIMEOUT=3
LLM_READ_TIMEOUT=75

# ============================================
# AURA v0.7.2.1 - Cloud Intelligence / Local Control
# ============================================
# ``hybrid`` reste accepté pour compatibilité, mais ``cloud`` est la cible.
AURA_RUNTIME_MODE=cloud
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile
GROQ_ROUTER_MODEL=llama-3.1-8b-instant
GROQ_CONNECT_TIMEOUT=2.5
GROQ_READ_TIMEOUT_SECONDS=12
GROQ_STT_ENABLED=true
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_STT_TIMEOUT_SECONDS=8

GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_UPLOAD_BASE_URL=https://generativelanguage.googleapis.com/upload/v1beta
GEMINI_FAST_MODEL=gemini-3.6-flash
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_DOCUMENT_MODEL=gemini-3.6-flash
GEMINI_CONNECT_TIMEOUT=3
GEMINI_READ_TIMEOUT_SECONDS=35
GEMINI_FILE_UPLOAD_TIMEOUT_SECONDS=45
GEMINI_NATIVE_PDF_ENABLED=true

DOCUMENT_ANALYSIS_PROVIDER=auto
DOCUMENT_CLOUD_ENABLED=true
DOCUMENT_LOCAL_CONTEXT_CHARS=6000
DOCUMENT_GROQ_CONTEXT_CHARS=12000
DOCUMENT_GEMINI_CONTEXT_CHARS=18000
DOCUMENT_NUM_PREDICT=4096
DOCUMENT_GEMINI_OUTPUT_TOKENS=4096
DOCUMENT_GEMINI_THINKING_LEVEL=low

# Le local génératif est un backend de compatibilité/survie, pas une dépendance.
HYBRID_LOCAL_FALLBACK=false
HYBRID_PRIVATE_MEMORY_LOCAL_ONLY=true
HYBRID_KEEP_OLLAMA_COLD=true

# Utilisateur
USER_NAME=
LOG_LEVEL=INFO

# ============================================
# VOICE v0.5.2 - local at runtime
# ============================================
VOICE_ENABLED=true
VOICE_AUTO_SPEAK=true
VOICE_PRELOAD=true

# Microphone push-to-talk
MIC_DEVICE=
# RC3: passive Windows microphone rediscovery; never starts recording by itself.
MIC_RECOVERY_ENABLED=true
MIC_RECOVERY_INITIAL_DELAY_MS=2000
MIC_RECOVERY_SECOND_DELAY_MS=5000
MIC_RECOVERY_RETRY_DELAY_MS=15000
MIC_RECOVERY_PORTAUDIO_REFRESH=true
MIC_SAMPLE_RATE=16000
MIC_CHANNELS=1
MIC_MAX_SECONDS=30
MIC_MIN_SECONDS=0.15
MIC_NORMALIZE=true
MIC_MAX_GAIN=8.0

# Speech-to-text (faster-whisper)
STT_MODEL=small
STT_MODEL_PATH=
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=fr
STT_BEAM_SIZE=1
STT_VAD_FILTER=false
STT_ALLOW_MODEL_DOWNLOAD=false

# TTS primary / fallback
# Le profil modifiable via le bouton "Voix" est stocké localement dans
# config/voice_profile.json et prend ensuite le relais sur ces valeurs initiales.
TTS_ENGINE=xtts
TTS_FALLBACK_ENGINE=piper
TTS_VOLUME=0.92
TTS_MAX_CHARS=900

# XTTS-v2 (installer explicitement avec INSTALL_XTTS.bat)
XTTS_DEVICE=cpu
XTTS_ALLOW_CUDA=false
XTTS_CUDA_DISPLAY_MIN_VRAM_MB=8192
RESOURCE_DISPLAY_GPU_RESERVE_MB=1536
XTTS_LANGUAGE=fr
XTTS_VOICE_MODE=preset
XTTS_PRESET_SPEAKER=Nova Hogarth
XTTS_SPEAKER_ID=AURA_CUSTOM
XTTS_REFERENCE_WAV=
XTTS_SPEED=0.96
XTTS_TEMPERATURE=0.68
XTTS_PREVIEW_FAST=true
XTTS_PREVIEW_MAX_CHARS=120
XTTS_SHORT_TEXT_NO_SPLIT_CHARS=360

# Fast Speech v0.6.5 - progressive XTTS pipeline
FAST_SPEECH_ENABLED=true
FAST_SPEECH_FIRST_CHUNK_CHARS=120
FAST_SPEECH_NEXT_CHUNK_CHARS=170
FAST_SPEECH_MIN_CHUNK_CHARS=48
FAST_SPEECH_MAX_SENTENCE_CHARS=180
FAST_SPEECH_MAX_CHUNKS=8
FAST_SPEECH_MIN_TEXT_CHARS=64
# Native XTTS inference_stream stays experimental/off by default.
FAST_SPEECH_NATIVE_STREAMING=false

# Piper fallback
TTS_VOICE=fr_FR-siwis-medium
TTS_MODEL_PATH=
TTS_LENGTH_SCALE=1.14
TTS_NOISE_SCALE=0.667
TTS_NOISE_W_SCALE=0.80

# Memory & Continuity v0.6
MEMORY_ENABLED=true
MEMORY_AUTO_CAPTURE=true
MEMORY_CONTEXT_LIMIT=5
MEMORY_RELEVANCE_THRESHOLD=0.55
MEMORY_ALLOW_SENSITIVE_CONTEXT=false
# ============================================
# RESOURCE GUARDIAN v0.6.2
# ============================================
# Protection recommandée pour les machines 16 Go RAM / GPU 6 Go VRAM.
RESOURCE_GUARDIAN_ENABLED=true
RESOURCE_ALLOW_HEAVY_PRELOAD=false
RESOURCE_RAM_WARN_PCT=88
RESOURCE_RAM_CRITICAL_PCT=94
RESOURCE_RAM_EMERGENCY_PCT=97
RESOURCE_VRAM_WARN_PCT=75
RESOURCE_VRAM_CRITICAL_PCT=85
RESOURCE_OLLAMA_RESIDUAL_VRAM_MB=256
RESOURCE_OLLAMA_UNLOAD_TIMEOUT=4
RESOURCE_GPU_QUERY_TIMEOUT=4.0
RESOURCE_GPU_SAMPLE_SECONDS=10
RESOURCE_XTTS_IDLE_SECONDS=300
RESOURCE_RELEASE_STT_AFTER_USE=true
RESOURCE_RELEASE_STT_BEFORE_LLM=true
RESOURCE_RELEASE_STT_BEFORE_TTS=true


# Optional override if Windows does not expose nvidia-smi in PATH.
NVIDIA_SMI_PATH=

# ============================================
# CONTROLLED INTERNET TOOLS v0.7.0
# ============================================
# No network call is made at startup. Requests happen only when a user query
# matches an authorized tool. Weather uses Open-Meteo and requires no key.
INTERNET_TOOLS_ENABLED=true
WEATHER_TOOL_ENABLED=true
WEB_FETCH_ENABLED=true
WEB_SEARCH_ENABLED=true
# RC2.4: zero-cost general Web search uses the local DDGS metasearch client.
# No search API key/account is required. AURA tries each backend independently,
# Google Web first, then DuckDuckGo, Startpage, Yahoo and Mojeek. If one is blocked/rate
# limited, the next free backend is tried. There is never a paid search fallback.
FREE_WEB_SEARCH_ENABLED=true
FREE_WEB_SEARCH_BACKENDS=google,duckduckgo,startpage,yahoo,mojeek
FREE_WEB_SEARCH_REGION=fr-fr
FREE_WEB_SEARCH_SAFESEARCH=moderate
FREE_WEB_SEARCH_TIMEOUT_SECONDS=8.0
FREE_WEB_SEARCH_SYNTHESIS_ENABLED=true
# Legacy Google Grounding settings retained for rollback/backward compatibility;
# RC2.4 normal explicit research does not select this path.
GOOGLE_SEARCH_GROUNDING_ENABLED=true
GOOGLE_SEARCH_MODEL=auto
GOOGLE_SEARCH_ALLOW_PAID_TIER=false
GOOGLE_SEARCH_DAILY_SAFETY_LIMIT=450
GOOGLE_SEARCH_MAX_OUTPUT_TOKENS=1600
GOOGLE_SEARCH_TIMEOUT_SECONDS=25.0
WEB_HTTP_TIMEOUT=8.0
WEB_MAX_RESPONSE_BYTES=262144
WEB_MAX_REDIRECTS=3
WEB_FETCH_MAX_TEXT_CHARS=1800
WEB_SEARCH_RESULT_COUNT=4
WEB_TOOL_PENDING_TTL_SECONDS=120
WEB_TOOL_CONTEXT_TTL_SECONDS=300

# v0.7.0.4 natural speech flow
FAST_SPEECH_CONTINUOUS_PLAYBACK=true
TTS_TAIL_FADE_MS=32
TTS_TAIL_SILENCE_MS=36

# Realtime dialogue v0.7.0.14
REALTIME_DIALOGUE_ENABLED=true
REALTIME_DIALOGUE_REQUIRE_CORESIDENCE=true
REALTIME_DIALOGUE_MAX_RAM_PCT=92
REALTIME_DIALOGUE_MAX_QUEUE_SEGMENTS=6
# True realtime: max synthesized sentences waiting ahead of playback.
REALTIME_DIALOGUE_AUDIO_QUEUE_SEGMENTS=2
REALTIME_DIALOGUE_MIN_SENTENCE_CHARS=4

# AURA v0.7.0.15.3 — true realtime XTTS + Visual Tool First + complete visual results
VOICE_MEMORY_WARN_PCT=88
VOICE_MEMORY_SOFT_PCT=91
VOICE_MEMORY_CRITICAL_PCT=94
VOICE_MEMORY_HARD_MIN_AVAILABLE_GB=1.15
VOICE_MEMORY_RECOVER_PCT=87
VOICE_MEMORY_RECOVER_AVAILABLE_GB=2.15
# XTTS startup prewarm: available RAM is primary; percent is a hard safety cap.
XTTS_PREWARM_MAX_RAM_PCT=86
XTTS_PREWARM_MIN_AVAILABLE_RAM_GB=3.5
XTTS_PREWARM_POSTLOAD_MAX_RAM_PCT=91
XTTS_PREWARM_POSTLOAD_MIN_AVAILABLE_RAM_GB=2.0
VISUAL_RESULT_HANDOFF_ENABLED=true
VISUAL_RESULT_INTENT_ENABLED=true
# Non-tool visual/list answers use a larger generation budget than voice-fast.
LLM_VISUAL_NUM_PREDICT=640
LLM_VISUAL_FAST_NUM_PREDICT=420
LLM_VISUAL_STRUCTURED_NUM_PREDICT=900
VISUAL_RESULT_MIN_CHARS=360
VISUAL_RESULT_TOOL_MIN_CHARS=220
VISUAL_RESULT_LONG_TOOL_CHARS=650

# AURA v0.7.0.15.4 — GPU Visual Core (Option A)
# Uses QOpenGLWidget + GLSL. Set false to force the legacy QPainter orb.
OPENGL_ORB_ENABLED=true
# 45 FPS is the default balance for a 6 GB consumer GPU while XTTS + voice LLM are resident.
OPENGL_ORB_FPS=45
# Follow-ups such as "donne les titres en anglais" stay attached to the last visual panel.
VISUAL_FOLLOWUP_TTL_SECONDS=600

# v0.7.1.2: audio has its own runtime switch. Legacy fast-test may remain
# configured without muting AURA as long as AUDIO_RUNTIME_ENABLED=true.
FAST_TEXT_TEST_MODE=false
AUDIO_RUNTIME_ENABLED=true
AUDIO_BACKGROUND_XTTS_PREWARM=true
AUDIO_XTTS_PREWARM_DELAY_MS=350
FAST_TEXT_TEST_PREWARM=true
FAST_TEXT_TEST_KEEP_ALIVE=30m
FAST_TEXT_TEST_PREWARM_DELAY_MS=0
FAST_TEXT_TEST_USE_VOICE_MODEL=true
WEATHER_HUD_POPUP_ENABLED=true
MAPS_TOOL_ENABLED=true
MAPS_HUD_POPUP_ENABLED=true
# Optional default origin used for directions. Leave empty to let Google Maps
# use the device/current position when available.
MAPS_DEFAULT_ORIGIN=
MAPS_MIN_ZOOM=3
MAPS_MAX_ZOOM=19
MAPS_LOCATION_ZOOM=13
MAPS_TILE_CACHE_MB=96
MAPS_MAX_PENDING_TILES=18

# Agent Kernel v0.7.1.0
AGENT_KERNEL_ENABLED=true
AGENT_MULTI_TOOL_ENABLED=true
AGENT_MAX_STEPS=6
AGENT_STOP_ON_ERROR=false
# v0.7.1.1 Fast Intelligence Router: strict JSON, small local model, invoked
# only for ambiguous multi-tool requests after the deterministic planner.
AGENT_LLM_PLANNER_ENABLED=true
AGENT_ROUTER_MODEL=llama3.2:3b
AGENT_ROUTER_KEEP_ALIVE=30m
AGENT_ROUTER_NUM_CTX=2048
AGENT_ROUTER_NUM_PREDICT=96
AGENT_ROUTER_TEMPERATURE=0.05
AGENT_ROUTER_TOP_P=0.70
AGENT_ROUTER_MIN_CONFIDENCE=0.62
AGENT_ROUTER_READ_TIMEOUT=6.0
AGENT_ROUTER_PRESERVE_HOT_XTTS=true
AGENT_TOOL_SELECTOR_MAX=5
AGENT_LOOP_MAX_SAME_SIGNATURE=2
AGENT_LOOP_MAX_SAME_ACTION=4
LOCAL_ACTION_PENDING_TTL_SECONDS=120
